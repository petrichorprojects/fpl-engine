# Copy to deploy/fpl-nag.env and fill in. Never commit the real file.

# n8n relay webhook (already live: workflow "FPL Lineup Nag Relay").
FPL_NAG_RELAY_URL=https://petrichorprojects.app.n8n.cloud/webhook/fpl-nag-relay

# YOUR Slack user id — only your image reply silences the nag.
# Find it: post any message in #pr-bot-talk yourself, then run
#   curl -s -X POST "$FPL_NAG_RELAY_URL" -H 'Content-Type: application/json' \
#     -d '{"mode":"history"}' | python3 -m json.tool | grep -m1 '"user"'
# Use the id that appears when YOU post (starts with U).
FPL_SLACK_USER_ID=U076BVACCRH
