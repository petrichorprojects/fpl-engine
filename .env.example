# ── FPL Engine Environment Variables ─────────────────────────────────────────

# Railway API URL (set in Vercel project settings)
# After `railway up`, run `railway domain` to get this
NEXT_PUBLIC_API_URL=https://fpl-engine-production.up.railway.app

# Optional: FPL credentials (for fetching your own team data)
FPL_TEAM_ID=
FPL_LOGIN=
FPL_PASSWORD=

# Optional: Mini-league tracking
FPL_LEAGUE_ID=
